# Copy to frontend/.env.local. Vite loads this workspace's env files automatically.
# All VITE_ values are public and embedded in the browser build.
# Public HTTPS origin of the deployed PixelPlaza backend. No trailing /api.
# Leave empty locally to use the Vite development proxy.
VITE_API_BASE_URL=

# Public PostHog ingestion token only. Never put personal API keys in VITE_ variables.
# Local: copy this file to frontend/.env.local. Vercel: add both variables, then redeploy.
VITE_POSTHOG_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
