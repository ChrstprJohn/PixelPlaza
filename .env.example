# Copy to .env.local, then use generated private PixelPlaza credentials.
# Backend-only runtime configuration consumed by the Node service.
# HOST and PORT control the backend listener; Docker Compose may override them.
HOST=127.0.0.1
PORT=3001
# Backend CORS allowlist: browser origins permitted to call the API.
FRONTEND_ORIGIN=http://localhost:5173,https://pixelplaza-live.vercel.app
# Admin sign-in, backend only. Use a unique 16–256 character password.
ADMIN_PASSWORD=
# Optional: a separate random session signing secret (32+ characters).
ADMIN_SESSION_SECRET=

# Backend lobby capacity limit.
LOBBY_PLAYER_LIMIT=10
# Backend-only Redis and realtime settings. Keep tokens and API keys server-side.
UPSTASH_REDIS_REST_URL=https://redis.chrbuilds.dev
UPSTASH_REDIS_REST_TOKEN=
REALTIME_API_URL=https://realtime.chrbuilds.dev/backend
REALTIME_API_KEY=
REALTIME_PROJECT_ID=pixelplaza
REALTIME_WEBSOCKET_URL=wss://realtime.chrbuilds.dev/connection/websocket

# Frontend only (public URL, safe in the browser bundle). Set in Vercel or frontend/.env.local.
VITE_API_BASE_URL=https://pixelplaza-api.chrbuilds.dev
