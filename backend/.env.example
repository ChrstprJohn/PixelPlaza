# Copy to backend/.env.local. Loaded by the root backend and service-check scripts.
# Backend only: never add these credentials to frontend env files or Vercel.
HOST=127.0.0.1
PORT=3001
# Comma-separated browser origins allowed to call the backend API.
FRONTEND_ORIGIN=http://localhost:5173,https://pixelplaza-live.vercel.app
# Unique 16-256 character admin password.
ADMIN_PASSWORD=
# Optional separate session signing secret (32+ characters).
ADMIN_SESSION_SECRET=

LOBBY_PLAYER_LIMIT=10
# Private Redis and realtime access. Keep tokens and API keys server-side.
UPSTASH_REDIS_REST_URL=https://redis.chrbuilds.dev
UPSTASH_REDIS_REST_TOKEN=
# Local development: requires the SSH tunnel described in documentation/LOCAL_DEVELOPMENT.md.
# VM Docker deployment: http://realtime-server:3000 (set by the Compose template).
# Private endpoints serve /token and /publish directly; do not append /backend.
REALTIME_API_URL=http://127.0.0.1:4300
REALTIME_API_KEY=
REALTIME_PROJECT_ID=pixelplaza
REALTIME_WEBSOCKET_URL=wss://realtime.chrbuilds.dev/connection/websocket

# Read-only PostHog pageview query. Backend only; never use VITE_ for these.
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_API_HOST=https://us.posthog.com

# PixelPlaza dashboard iframe URL. Returned only after admin sign-in; no VITE_ prefix.
# Use the dashboard's shared/embedded URL, not a normal /project/.../dashboard/... URL.
POSTHOG_DASHBOARD_EMBED_URL=
